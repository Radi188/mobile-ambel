{
  "expo": {
    "name": "BongPOS Owner",
    "slug": "mobile-ambel",
    "scheme": "bongpos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cross.ambelcoffee.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "cross.ambelcoffee.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BongPOS Owner uses your photo library so you can attach a photo to a product."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce112e8d-4f4e-449b-89a4-5242b7ff1379"
      }
    },
    "backgroundColor": "#FFFFFF"
  }
}
